# Meta Model API (https://dev.meta.ai/products/meta-model-api)
META_API_KEY=

# Optional inference partners for Meta open-weight models
# Model ID for the hackathon: meta-models/muse-spark-open-1026
BASETEN_API_KEY=
FIREWORKS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# CERES settings (empty or default values only)
SAM_BACKEND=api
EDGE_MODE=recorded
# EDGE_MODE=remote_glimmer needs an OpenAI-compatible Glimmer endpoint (not used in this build):
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=
CERES_BUDGET_USD=100
DEMO_MODE=0
GROQ_API_KEY=

# Offline demo (make demo sets these): DEMO_MODE=1 replays recorded model runs, no key and no network.
# IMAGES_ROOT=data/demo/frames      serve frame images by file name from this directory
# CERES_REPLAY_PACE_S=0.6           pause between replayed events so the stream is readable
