{
  "type": "object",
  "additionalProperties": false,
  "required": ["tray_id", "status", "findings", "probable_causes", "causes_considered", "recommended_actions", "setpoint_caveats", "missing_evidence", "crew_brief"],
  "properties": {
    "tray_id": {"type": "string"},
    "status": {"enum": ["nominal", "watch", "alert"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence_ids", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "probable_causes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "likelihood", "evidence_ids", "discriminating_check"],
        "properties": {
          "cause": {"enum": ["underwatering", "overwatering", "low_light", "excess_light", "high_vpd", "low_vpd", "temperature_stress", "co2_anomaly", "nutrient_ph_issue", "sensor_fault", "camera_fault", "normal_variation", "other"]},
          "likelihood": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "discriminating_check": {"type": "string"}
        }
      }
    },
    "causes_considered": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "magnitude", "rationale", "evidence_ids"],
        "properties": {
          "action": {"type": "string"},
          "magnitude": {"type": "string"},
          "rationale": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "setpoint_caveats": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "crew_brief": {"type": "string", "maxLength": 400}
  }
}
